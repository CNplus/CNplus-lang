{
  "name": "cnplus",
  "displayName": "CNplus",
  "description": "CNplus 中文编程语言支持：语法高亮、实时诊断、一键运行",
  "version": "1.4.0",
  "publisher": "cnplus",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Education"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "不受信任的窗口中，语法高亮仍可用；实时诊断与运行功能需要信任工作区后才能使用。"
    }
  },
  "activationEvents": [
    "onLanguage:cnplus"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cnplus",
        "aliases": [
          "CNplus",
          "cnplus"
        ],
        "extensions": [
          ".cnp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cnplus",
        "scopeName": "source.cnplus",
        "path": "./syntaxes/cnplus.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "cnplus.运行当前文件",
        "title": "CNplus: 运行当前文件",
        "icon": "$(play)"
      },
      {
        "command": "cnplus.显示解释器",
        "title": "CNplus: 显示当前使用的解释器"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "cnplus.运行当前文件",
          "when": "resourceLangId == cnplus",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "cnplus.运行当前文件",
        "key": "f5",
        "when": "resourceLangId == cnplus"
      }
    ],
    "configuration": {
      "title": "CNplus",
      "properties": {
        "cnplus.python路径": {
          "type": "string",
          "default": "",
          "description": "运行 CNplus 的 Python 解释器路径。留空即自动探测（依次尝试工作区 .venv、Homebrew、系统 Python）。只有自动探测选错时才需要手填。"
        },
        "cnplus.启用LSP": {
          "type": "boolean",
          "default": true,
          "description": "启用实时诊断（需要安装 pygls）"
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/CNplus/CNplus-lang.git"
  },
  "bugs": {
    "url": "https://github.com/CNplus/CNplus-lang/issues"
  },
  "homepage": "https://wiki.cnplus.org",
  "keywords": [
    "cnplus",
    "中文编程",
    "chinese",
    "programming-language",
    "中文",
    "教学"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1f2430",
    "theme": "dark"
  }
}