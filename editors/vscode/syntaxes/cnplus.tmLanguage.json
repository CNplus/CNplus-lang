{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CNplus",
  "scopeName": "source.cnplus",
  "fileTypes": [
    "cnp"
  ],
  "_生成说明": "本文件由 tools/生成语法文件.py 从 keywords.toml 生成，请勿手改",
  "patterns": [
    {
      "name": "comment.line.number-sign.cnplus",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.cnplus",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.cnplus",
          "match": "\\\\\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single.cnplus",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.cnplus",
          "match": "\\\\\\\\."
        }
      ]
    },
    {
      "name": "keyword.control.conditional.cnplus",
      "match": "要不然|如果|假如|否则|不然|若"
    },
    {
      "name": "keyword.control.loop.cnplus",
      "match": "循环|重复|当"
    },
    {
      "name": "keyword.control.flow.cnplus",
      "match": "返回|给出|返"
    },
    {
      "name": "keyword.declaration.cnplus",
      "match": "函数|定义|过程|外部|全局|设|令|让"
    },
    {
      "name": "constant.language.boolean.cnplus",
      "match": "真|假"
    },
    {
      "name": "constant.language.null.cnplus",
      "match": "空"
    },
    {
      "name": "keyword.operator.logical.cnplus",
      "match": "并且|或者|与|或|非"
    },
    {
      "match": "(?:函数|定义|过程)\\s+([^\\s(（]+)",
      "captures": {
        "1": {
          "name": "entity.name.function.cnplus"
        }
      }
    },
    {
      "match": "([^\\s(（），,+\\-*/%<>=!]+)\\s*[(（]",
      "captures": {
        "1": {
          "name": "entity.name.function.call.cnplus"
        }
      }
    },
    {
      "name": "constant.numeric.cnplus",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    {
      "name": "keyword.operator.cnplus",
      "match": "\\/\\/|==|!=|<=|>=|\\+|\\-|\\*|\\/|\\%|<|>|="
    }
  ]
}
