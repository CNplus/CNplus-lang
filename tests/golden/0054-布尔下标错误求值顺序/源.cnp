设 对象次数 = 0
设 下标次数 = 0
设 右侧次数 = 0
设 名单 = [10, 20]

函数 取名单()
    对象次数 += 1
    返回 名单

函数 取文字()
    对象次数 += 1
    返回 "甲乙"

函数 取布尔()
    下标次数 += 1
    返回 真

函数 取右侧()
    右侧次数 += 1
    返回 99

尝试
    打印(取名单()[取布尔()])
捕获 错误
    打印(对象次数)
    打印(下标次数)

对象次数 = 0
下标次数 = 0
尝试
    打印(取文字()[取布尔()])
捕获 错误
    打印(对象次数)
    打印(下标次数)

对象次数 = 0
下标次数 = 0
右侧次数 = 0
尝试
    取名单()[取布尔()] = 取右侧()
捕获 错误
    打印(对象次数)
    打印(下标次数)
    打印(右侧次数)

对象次数 = 0
下标次数 = 0
右侧次数 = 0
尝试
    取名单()[取布尔()] += 取右侧()
捕获 错误
    打印(对象次数)
    打印(下标次数)
    打印(右侧次数)
