# 类与对象：把数据和它的用法绑在一起
# 运行：cnp 运行 示例/18-班级成绩册.cnp

类 学生
    初始化(名字, 分数)
        如果 分数 < 0 或 分数 > 100
            抛出 @"分数必须在 0 到 100 之间，{名字}的分数是 {分数}"
    函数 等级()
        如果 自己.分数 >= 90
            返回 "优秀"
        否则 如果 自己.分数 >= 60
            返回 "及格"
        否则
            返回 "不及格"
    函数 名片()
        返回 @"{自己.名字}：{自己.分数} 分（{自己.等级()}）"

类 班级
    初始化(名称)
        # 派生字段：初始化块体里造的列表，不用写转存
        自己.成员 = []
    函数 加入(一名学生)
        追加(自己.成员, 一名学生)
        打印(@"  {一名学生.名片()} 加入 {自己.名称}")
    函数 人数()
        返回 长度(自己.成员)
    函数 平均分()
        设 总 = 0
        遍历 自己.成员 每个 一名
            总 = 总 + 一名.分数
        如果 自己.人数() == 0
            返回 0
        返回 总 / 自己.人数()
    函数 汇报()
        打印(@"—— {自己.名称}：{自己.人数()} 名学生，平均 {自己.平均分()} 分 ——")
        遍历 自己.成员 每个 一名
            打印(@"  {一名.名片()}")


# —— 建 ——
设 三班 = 班级("三年二班")

遍历 [["小明", 92], ["小红", 85], ["小刚", 58], ["小丽", 74]] 每个 记录
    设 一名 = 学生(记录[0], 记录[1])
    三班.加入(一名)

# —— 报 ——
三班.汇报()

# —— 改（字段可写）——
设 小刚 = 三班.成员[2]
小刚.分数 = 63
打印(@"小刚补考后：{小刚.名片()}")
三班.汇报()
