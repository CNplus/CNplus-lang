设 次数 = 0

函数 取非列表()
    次数 += 1
    打印("直接对象", 次数)
    返回 "甲"

函数 取分隔()
    次数 += 1
    打印("直接分隔", 次数)
    返回 "-"

尝试
    连接(取非列表(), 取分隔())
捕获 错误
    打印("接住直接")
打印("直接次数", 次数)

函数 取列表()
    次数 += 1
    打印("点对象", 次数)
    返回 [1]

函数 取坏分隔()
    次数 += 1
    打印("点分隔", 次数)
    返回 2

尝试
    取列表().连接(取坏分隔())
捕获 错误
    打印("接住点调用")
打印("总次数", 次数)
