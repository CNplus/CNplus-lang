# ============================================================
# 通讯录 —— CNplus 全特性巡礼
#
# 这个程序把 CNplus 目前的每一样语法都自然地用了一遍，
# 既是给人看的"全貌"，也是活的回归测试。
#
# 覆盖清单（对照检查）：
#   变量、算术、字符串拼接、真值/比较
#   如果 / 否则如果 / 否则
#   循环、遍历、跳出、继续
#   函数、默认参数、关键字参数、多返回值、递归
#   列表、字典、索引读写、成员方法
#   自增(++)、复合赋值(+=)
#   格式串(填)、输入(询问/询问数值)
#   异常(尝试/捕获/最后/抛出)
#   导入 Python 库、类型转换
# ============================================================

导入 "json" 作为 J

# ---- 造一条联系人（默认参数）----
函数 造联系人(名字, 电话, 分组 = "朋友")
    返回 {"名字": 名字, "电话": 电话, "分组": 分组, "星标": 假}

# ---- 校验电话号（抛出 + 字符串方法）----
函数 校验电话(号码)
    如果 长度(号码) < 3
        抛出 填"电话「{号码}」太短了"
    返回 号码

# ---- 统计各分组人数（字典 + 遍历 + 复合赋值）----
函数 按分组统计(通讯录)
    设 计数 = {}
    遍历 通讯录 每个 人
        设 组 = 人["分组"]
        如果 有标签(计数, 组)
            计数[组] += 1
        否则
            计数[组] = 1
    返回 计数

# ---- 找联系人：返回是否找到 + 索引（多返回值）----
函数 查人(通讯录, 名字)
    设 序号 = 0
    遍历 通讯录 每个 人
        如果 人["名字"] == 名字
            返回 真, 序号
        序号++
    返回 假, -1

# ---- 递归：数字转中文星级 ----
函数 星星(n)
    如果 n <= 0
        返回 ""
    返回 "★" + 星星(n - 1)

# ---- 显示一条联系人（格式串 + 否则如果）----
函数 显示(人)
    设 标记 = " "
    如果 人["星标"]
        标记 = "★"
    设 组名 = 人["分组"]
    设 图标 = ""
    如果 组名 == "家人"
        图标 = "家"
    否则 如果 组名 == "同事"
        图标 = "工"
    否则
        图标 = "友"
    打印(填"  {标记}[{图标}] {人[\'名字\']}  {人[\'电话\']}")

# ============================================================
# 主程序
# ============================================================

打印("======== 我的通讯录 ========")

# 建通讯录（列表 + 成员方法 + 关键字参数）
设 通讯录 = []
通讯录.追加(造联系人("小明", "13800138000", 分组 = "家人"))
通讯录.追加(造联系人("小红", "13900139000", 分组 = "同事"))
通讯录.追加(造联系人("小刚", "13700137000"))

# 给第一个人加星标（索引 + 字典写）
通讯录[0]["星标"] = 真

# 演示异常：故意加一个电话太短的
尝试
    校验电话("12")
    通讯录.追加(造联系人("错误", "12"))
捕获 错
    打印(填"添加失败：{错}")

打印("")
打印(填"共 {长度(通讯录)} 位联系人：")
遍历 通讯录 每个 人
    显示(人)

# 分组统计（遍历字典 + 格式串）
打印("")
打印("分组统计：")
设 统计 = 按分组统计(通讯录)
遍历 统计 每个 组
    打印(填"  {组}：{统计[组]} 人")

# 查找演示（多返回值解包）
打印("")
遍历 ["小红", "老王"] 每个 目标
    设 找到, 位置 = 查人(通讯录, 目标)
    如果 找到
        打印(填"找到 {目标}，在第 {位置 + 1} 位")
    否则
        打印(填"没找到 {目标}")

# 递归星级
打印("")
打印(填"三星评价：{星星(3)}")

# 循环 + 跳出/继续：找第一个"同事"
打印("")
设 i = 0
循环 i < 长度(通讯录)
    设 人 = 通讯录[i]
    i++
    如果 人["分组"] != "同事"
        继续
    打印(填"第一个同事是：{人[\'名字\']}")
    跳出

# 存档（导入的 JSON 库 + 最后）
打印("")
尝试
    设 存档 = J.dumps(通讯录, ensure_ascii = 假)
    打印(填"已生成存档（{长度(存档)} 字符）")
捕获 错
    打印(填"存档失败：{错}")
最后
    打印("通讯录程序结束")
