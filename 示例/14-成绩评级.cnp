# 综合示例：否则如果 + 默认参数 + 成员方法 + 自增

# 默认参数：满分默认 100，不给就用默认
函数 评级(分, 满分 = 100)
    设 比 = 分 / 满分 * 100
    如果 比 >= 90
        返回 "优秀"
    否则 如果 比 >= 75
        返回 "良好"
    否则 如果 比 >= 60
        返回 "及格"
    否则
        返回 "不及格"

设 成绩单 = [95, 82, 67, 40]

# 成员方法调用：成绩单.长度()
打印("一共 " + 文本(成绩单.长度()) + " 个成绩")

设 优秀数 = 0
遍历 成绩单 每个 分
    设 级 = 评级(分)
    打印(文本(分) + " 分 → " + 级)
    如果 级 == "优秀"
        优秀数++          # 自增

打印("优秀 " + 文本(优秀数) + " 人")

# 关键字参数：明确指定满分
打印("按 150 分算：" + 评级(分 = 120, 满分 = 150))
