# 用循环 + 跳出，写一个会自动二分猜数的小程序

设 答案 = 随机数(1, 100)
设 下限 = 1
设 上限 = 100
设 次数 = 0

循环 真
    次数 = 次数 + 1
    设 猜 = (下限 + 上限) // 2
    如果 猜 == 答案
        打印("第 " + 文本(次数) + " 次猜中！答案是 " + 文本(答案))
        跳出
    如果 猜 < 答案
        打印("猜 " + 文本(猜) + "，小了")
        下限 = 猜 + 1
    否则
        打印("猜 " + 文本(猜) + "，大了")
        上限 = 猜 - 1
