# ============================================================
# 待办清单管理器 —— CNplus 综合示例（可交互）
#
# 这个程序把 CNplus 目前所有语法特性都用了一遍，
# 既是演示，也是活的回归测试。
#
# 用到：变量、算术、字符串、格式串（填）、
#       如果/否则如果/否则、循环、遍历、跳出、继续、
#       函数（默认参数、关键字参数、多返回值）、
#       列表、字典、索引读写、成员方法调用、
#       自增（++）、复合赋值（+=）、
#       输入（问、问数字）、导入 Python 库、严格真值
# ============================================================

导入 "json" 作为 J

# ---- 造一个任务（默认参数：优先级默认为中）----
函数 造任务(编号, 内容, 优先级 = 2)
    返回 {"编号": 编号, "内容": 内容, "优先级": 优先级, "完成": 假}

# ---- 统计：一次返回两个值（多返回值）----
函数 统计(任务们)
    设 已完成 = 0
    遍历 任务们 每个 t
        如果 t["完成"]
            已完成++
    返回 长度(任务们), 已完成

# ---- 优先级数字转文字（否则如果链）----
函数 优先级名(p)
    如果 p == 3
        返回 "高"
    否则 如果 p == 2
        返回 "中"
    否则 如果 p == 1
        返回 "低"
    否则
        返回 "？"

# ---- 显示一个任务（格式串）----
函数 显示任务(t)
    设 标记 = "[ ]"
    如果 t["完成"]
        标记 = "[√]"
    设 内容 = t["内容"]
    设 级 = 优先级名(t["优先级"])
    打印(填"  {标记} #{t[\"编号\"]} 【{级}】{内容}")

# ---- 列出全部 ----
函数 列出(清单)
    如果 长度(清单) == 0
        打印("  （清单是空的）")
        返回 空
    遍历 清单 每个 t
        显示任务(t)

# ============================================================
# 主程序
# ============================================================

设 清单 = []
设 下一个编号 = 1

# 预置几条，省得一上来就是空的
清单.追加(造任务(下一个编号, "读完 CNplus 教程", 3))
下一个编号++
清单.追加(造任务(下一个编号, "买菜"))
下一个编号++
清单.追加(造任务(下一个编号, "回邮件", 1))
下一个编号++

打印("=== 待办清单管理器 ===")
打印("命令：1 看清单  2 加任务  3 完成任务  4 统计  5 存档  0 退出")

循环 真
    打印("")
    设 命令 = 问("请输入命令编号：")

    如果 命令 == "0"
        打印("再见！")
        跳出

    否则 如果 命令 == "1"
        打印("当前清单：")
        列出(清单)

    否则 如果 命令 == "2"
        设 内容 = 问("任务内容：")
        如果 长度(内容) == 0
            打印("内容不能为空，没有添加。")
            继续
        设 级 = 问数字("优先级（1低 2中 3高）：")
        如果 级 < 1 或 级 > 3
            打印("优先级只能是 1、2、3，按「中」处理。")
            级 = 2
        # 关键字参数：把优先级明确写出来
        清单.追加(造任务(下一个编号, 内容, 优先级 = 整数(级)))
        打印(填"已添加 #{下一个编号}：{内容}")
        下一个编号++

    否则 如果 命令 == "3"
        设 目标 = 问数字("要完成哪个编号？")
        设 找到 = 假
        遍历 清单 每个 t
            如果 t["编号"] == 目标
                如果 t["完成"]
                    打印("这条早就完成了。")
                否则
                    t["完成"] = 真
                    打印(填"完成 #{目标}：{t[\"内容\"]}")
                找到 = 真
                跳出
        如果 非 找到
            打印(填"没有编号 {目标} 的任务。")

    否则 如果 命令 == "4"
        设 总数, 完成数 = 统计(清单)
        如果 总数 == 0
            打印("清单是空的，没什么可统计。")
            继续
        设 完成率 = 完成数 / 总数 * 100
        打印(填"共 {总数} 条，完成 {完成数} 条，完成率 {四舍五入(完成率)}%")
        # 按优先级从高到低分组显示（循环 + 复合赋值）
        设 档 = 3
        循环 档 >= 1
            设 这档 = []
            遍历 清单 每个 t
                如果 t["优先级"] == 档
                    这档.追加(t)
            如果 长度(这档) > 0
                打印(填"【{优先级名(档)}】{长度(这档)} 条")
                列出(这档)
            档 -= 1

    否则 如果 命令 == "5"
        设 文本形 = J.dumps(清单, ensure_ascii = 假)
        打印(填"存档内容（{长度(文本形)} 字符）：")
        打印(文本形)

    否则
        打印(填"不认识命令「{命令}」，请输入 0-5。")
