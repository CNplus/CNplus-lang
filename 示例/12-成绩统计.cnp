# 字典：把名字和分数对应起来，做一次成绩统计
# 直接「遍历 成绩 每个 名字」就能逐个取出标签（这里标签就是人名）

设 成绩 = {"小明": 85, "小红": 92, "小刚": 78}

设 总分 = 0
遍历 成绩 每个 名字
    打印(名字 + "：" + 文本(成绩[名字]) + " 分")
    总分 = 总分 + 成绩[名字]

设 平均 = 总分 / 长度(成绩)
打印("平均分：" + 文本(平均))
打印("最高分：" + 文本(最大(所有值(成绩))))

# 找出不及格的
打印("需要努力的同学：")
遍历 成绩 每个 名字
    如果 成绩[名字] < 80
        打印("  " + 名字)
