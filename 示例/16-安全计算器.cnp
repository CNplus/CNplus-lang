# 安全计算器 —— 用「尝试 / 捕获」优雅处理各种出错
# 演示：抛出、捕获、最后，以及用异常做输入校验

函数 安全除法(a, b)
    如果 b == 0
        抛出 "除数不能是零"
    返回 a / b

打印("=== 安全计算器 ===")

# 一组测试数据：有正常的，也有会出错的
设 题目 = [[10, 2], [7, 0], [9, 3]]

遍历 题目 每个 题
    设 甲 = 题[0]
    设 乙 = 题[1]
    尝试
        设 商 = 安全除法(甲, 乙)
        打印(@"{甲} ÷ {乙} = {商}")
    捕获 错
        打印(@"{甲} ÷ {乙} 算不了：{错}")

打印("")

# 用异常包住「文字转数字」，转不了就给默认值
函数 安全转数(文字, 默认 = 0)
    尝试
        返回 整数(文字)
    捕获 错
        返回 默认

打印(@"「42」转成数字：{安全转数('42')}")
打印(@"「abc」转成数字（给默认）：{安全转数('abc')}")
打印(@"「xyz」转成数字（默认 -1）：{安全转数('xyz', 默认 = -1)}")

打印("")

# 最后：无论成功失败都要做的收尾
函数 处理任务(名字, 会失败)
    打印(@"开始处理 {名字}")
    尝试
        如果 会失败
            抛出 "任务失败了"
        打印("  处理成功")
    捕获 错
        打印(@"  出错：{错}")
    最后
        打印("  清理资源（无论成功失败都执行）")

处理任务("任务A", 假)
处理任务("任务B", 真)
